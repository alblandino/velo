  "cliente": {
    "conectado": "Connected to {host}:{puerto}",
    "instrucciones": "Type a command or \"exit\" to quit.",
    "errorConexion": "Could not connect to {host}:{puerto}: {error}",
    "sugerenciaServidor": "Make sure the server is running with: velo server",
    "errorSocket": "Socket error: {error}",
    "cerradaPorServidor": "Connection closed by the server.",
    "conexionCerrada": "The connection to the server was closed.",
    "desconectando": "Disconnecting...",
    "sesionTerminada": "Session ended.",
    "formato": {
      "nulo": "(nil)",
      "error": "(error) {mensaje}",
      "entero": "(integer) {valor}",
      "arrayVacio": "(empty array)"
    }
  },

  "cli": {
    "ayuda": [
      "velo v{version} - In-memory data store (RESP protocol over TCP)",
      "",
      "Usage:",
      "  velo server [options]                Start the server",
      "  velo [options]                       Open the interactive REPL client",
      "  velo [options] command [args ...]    Run one command and exit",
      "",
      "Client options go before the command; everything after the command",
      "is sent to the server as is.",
      "",
      "Connection (server and client):",
      "  -h, --host <host>        Server host (current: {host})",
      "  -p, --port <port>        Server port (current: {puerto})",
      "",
      "Client:",
      "  -n, --db <index>         Database to select after connecting",
      "",
      "Server:",
      "  --max-connections <n>    Maximum simultaneous connections",
      "  --log-level <level>      debug | info | warn | error",
      "  --db-count <n>           Number of databases",
      "  --sweep-interval <ms>    Interval of the expired keys sweep",
      "",
      "General:",
      "  --help                   Show this help",
      "  -v, --version            Show the version",
      "",
      "Examples:",
      "  velo server --port 7000 --log-level debug",
      "  velo set greeting hello",
      "  velo get greeting",
      "  velo -p 7000 -n 2 keys \"*\""
    ],
    "errores": {
      "opcionDesconocida": "unknown option: {opcion}",
      "faltaValor": "missing value for option {opcion}",
      "valorEntero": "option {opcion} expects an integer (got: {valor})",
      "valorNivel": "option {opcion} expects one of: {niveles} (got: {valor})",
      "argumentoInesperado": "unexpected argument for server mode: {argumento}",
      "verAyuda": "Run \"velo --help\" to see the help."
    }
  },

  "dev": {
    "vigilando": "Watching {carpeta}/ for changes (Ctrl+C to quit)",
    "reiniciando": "Change detected in {archivo}. Restarting server..."
  }
}
